APP_ENV=local
LOG_LEVEL=INFO

# Browser / scraper behavior
HEADLESS_BROWSER=false
REQUEST_TIMEOUT_SECONDS=30
SCRAPER_DELAY_SECONDS=1

# Greenville portal configuration
GREENVILLE_OLD_SEARCH_URL=
GREENVILLE_NEW_SEARCH_URL=
GREENVILLE_USERNAME=
GREENVILLE_PASSWORD=

# Future HBR staging/database integration
# Leave unused until Rigic confirms the integration method.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
